# VariPro Modbus-MQTT silta - esimerkkiasetukset
# Kopioi: sudo cp varipro.env.example /etc/varipro.env  ja muokkaa arvot.
# Tyhjä tai puuttuva arvo = oletus. Kommentit vain omille riveilleen.

# Modbus TCP -yhdyskäytävä (RS-485 -> TCP). VARIPRO_MODBUS_HOST on pakollinen.
VARIPRO_MODBUS_HOST=modbus-gateway.example
VARIPRO_MODBUS_PORT=502
VARIPRO_SLAVE=1
#VARIPRO_MODBUS_TIMEOUT=5

# MQTT-broker (Home Assistantin näkemä)
VARIPRO_MQTT_HOST=mqtt-broker.example
VARIPRO_MQTT_PORT=1883
VARIPRO_MQTT_USER=
VARIPRO_MQTT_PASS=

# Valinnaiset
# Toinen säädin: eri etuliite, esim. varipro2
#VARIPRO_TOPIC_PREFIX=varipro
#VARIPRO_DISCOVERY_PREFIX=homeassistant
#VARIPRO_MIN_TEMP=18
#VARIPRO_MAX_TEMP=24
#VARIPRO_DEADZONE_MAX=15
# DEBUG näyttää jokaisen julkaisun
#VARIPRO_LOG_LEVEL=INFO
