# VariPro Modbus-MQTT silta - esimerkkiasetukset
# Kopioi: sudo cp varipro.env.example /etc/varipro.env  ja muokkaa arvot.

# Modbus TCP -yhdyskäytävä (RS-485 -> TCP)
VARIPRO_MODBUS_HOST=192.168.1.215
VARIPRO_MODBUS_PORT=502
VARIPRO_SLAVE=1

# MQTT-broker (Home Assistantin näkemä)
VARIPRO_MQTT_HOST=192.168.1.10
VARIPRO_MQTT_PORT=1883
VARIPRO_MQTT_USER=
VARIPRO_MQTT_PASS=
